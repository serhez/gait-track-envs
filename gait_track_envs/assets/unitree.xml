    <material name="dark" rgba="0.1 0.1 0.1 1"/>
    <mesh class="go1" file="trunk.stl"/>
    <mesh class="go1" file="hip.stl"/>
    <mesh class="go1" file="thigh_mirror.stl"/>
    <mesh class="go1" name="calf_fr" file="calf.stl" scale="1.0 1.0 {{size[0] / 0.2}}"/>
